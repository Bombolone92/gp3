#!/bin/sh
#############################
# GPIO PINS CONFIGURATION
#############################
getHwInfo()
{
	grep -w $1 /bak/hardinfo.bin | awk -F '>'  '{print $2}' | awk -F '<' '{print $1}'
}

getHwCfg()
{
	grep $1 /bak/hwcfg.ini | awk '{printf $3}'
}

getHwInfoWifiPins()
{
	echo $(getHwInfo $1) | awk -F '_'  '{print $1}'
}

getHwInfoPinValidLvl()
{
	echo $(getHwInfo $1) | awk -F '_'  '{print $4}'
}

#wifi Power  ---
defSupport4G=$(getHwInfo Support4G)
support4G=$(getHwCfg support_4g)
ctrlPin=
validLvl=
if [ "$support4G" = "1" -o "$defSupport4G" = "1" ];then
	ctrlPin=$(getHwInfoWifiPins 4GCtrl)
	validLvl=$(getHwInfoPinValidLvl 4GCtrl)
else
	ctrlPin=$(getHwInfoWifiPins WifiCtrl)
	validLvl=$(getHwInfoPinValidLvl WifiCtrl)
fi

if [ -n "$ctrlPin" -a "$ctrlPin" != "-1" -a -n "$validLvl" ];then
	gio -do $ctrlPin 0
	if [ "$validLvl" = "1" ];then
		gio -s $ctrlPin 0
	else
		gio -s $ctrlPin 1
	fi
	sleep 2
	gio -s $ctrlPin $validLvl
fi
# tangecam ssh persistence (retry, waits for mmc)
K=/tmp/mnt/mmc01/0/tangecam
( i=0; while [ ! -x $K/dropbear ]; do sleep 3; i=$((i+1)); [ $i -gt 60 ] && break; done;
  mount -o remount,rw /bak 2>/dev/null;
  mkdir -p /bak/root/.ssh 2>/dev/null;
  cp $K/authorized_keys /bak/root/.ssh/authorized_keys 2>/dev/null;
  chmod 700 /bak/root/.ssh 2>/dev/null; chmod 600 /bak/root/.ssh/authorized_keys 2>/dev/null;
  mount -o bind /bak/root /root 2>/dev/null;
  $K/dropbear -p 0.0.0.0:2222 -r $K/dbkey_ed25519 2>/dev/null & 
) &
# tangecam-control persistence (from /bak flash)
( i=0; while [ ! -x /bak/tangecam/run-control.sh ]; do
    sleep 3
    i=$((i+1))
    [ "$i" -gt 60 ] && exit 0
  done
  TANGECAM_DIR=/bak/tangecam /bak/tangecam/run-control.sh
) &
